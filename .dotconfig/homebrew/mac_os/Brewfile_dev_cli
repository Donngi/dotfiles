cask_args appdir: "/Applications"

# Utility
brew "jq"
brew "yq"
brew "fzf"
brew "nmap"
brew "tree"
brew "bat"
brew "ripgrep"
brew "exiftool"

# AWS
brew "awscli"
brew "git-remote-codecommit"
brew "cfn-lint"
brew "rain"

cask "session-manager-plugin"

# Git
brew "git"
brew "gh"
brew "ghq"
brew "git-secrets"
brew "gibo"

# Docker
# NOTE: In commercial use, you mustn't use docker desktop without payment.
#
# If you want to make docker environment without docker desktop,
# use 'brew docker' instead of  'cask docker-desktop'.
# brew "docker"
cask "docker-desktop"

# xxenv
brew "tfenv"
brew "pipenv"
brew "pyenv"
brew "uv"
brew "rbenv"

# terraform
brew "tflint"

# Java
brew "maven"
brew "gradle"

# Swift
brew "swiftlint"
brew "xcodegen"

# Go
brew "go"

# Node
brew "bun"
brew "pnpm"

# Vim
brew "neovim"
brew "tree-sitter-cli"

# LSP servers
brew "lua-language-server"
brew "gopls"
brew "pyright"
brew "ruff"
brew "vtsls"
brew "bash-language-server"
brew "yaml-language-server"
brew "terraform-ls"
brew "biome"

# Formatters
brew "stylua"
brew "gofumpt"
brew "shfmt"
# プロジェクト外のファイル用のフォールバック。プロジェクト内では conform が
# node_modules/.bin/prettier (公式推奨のローカルインストール) を優先する。
brew "prettier"
# prettier の常駐デーモン版。conform 側で prettier より優先させれば高速化できる。
brew "prettierd"
brew "taplo"
# pyproject.toml に [tool.black] があるプロジェクトでのみ使う (無ければ ruff が担当)
brew "black"
brew "isort"

# Linters
brew "shellcheck"
brew "yamllint"
# 以下はプロジェクトに設定ファイルがあるときだけ有効になる (nvim-lint 側で判定)
brew "eslint_d"
brew "golangci-lint"
brew "hadolint"

# Prompt
brew "pure"

# Nerd Font (for nvim-web-devicons, etc.)
cask "font-jetbrains-mono-nerd-font"
